# App
DATABASE_URL="postgresql://coop:coop@localhost:5432/coop_launch?schema=public"
SESSION_SECRET="dev-session-secret-change-me-32chars-min"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="coop-launch"
S3_FORCE_PATH_STYLE="true"

# Auth rate limit
LOGIN_MAX_ATTEMPTS="10"
LOGIN_WINDOW_MINUTES="15"

# Backups
BACKUP_DIR="./backups"
BACKUP_ENCRYPTION_KEY="dev-backup-key-change-in-prod"
