generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COORDINATOR
  INDUSTRY_FOUNDER
  FOUNDING_MEMBER
  ADVISER
  READ_ONLY
  ADMIN
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  ACHIEVED
  CANCELLED
}

enum GateCriterionType {
  BOOLEAN
  NUMERIC_MIN
  REQUIRED_DOCUMENT
  REQUIRED_REVIEW
  REQUIRED_EXTERNAL_ANSWER
  MANUAL_APPROVAL
}

enum OrgPersonStatus {
  ACTIVE
  CONTACTED
  QUALIFIED
  NURTURE
  DO_NOT_PURSUE
  ARCHIVED
}

enum AssumptionConfidence {
  VERIFIED
  ESTIMATE
  ASSUMPTION
}

enum FounderActionType {
  DONE
  COMMENT
  CALL_NESLI
  DEFER
}

enum FounderActionStatus {
  OPEN
  DONE
  DEFERRED
  CANCELLED
}

enum AdviceStatus {
  OPEN
  IN_PROGRESS
  ACCEPTED
  DECLINED
  DEFERRED
}

enum RiskStatus {
  OPEN
  MITIGATING
  CLOSED
  ACCEPTED
}

enum RegistrationPriority {
  MANDATORY
  IMPORTANT
  OPTIONAL
}

enum QuestionKind {
  TEXT
  NUMBER
  BOOLEAN
  TAG
  CONFIDENTIAL_FINANCIAL
}

enum StageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions              Session[]
  totp                  TotpCredential?
  ownedTasks            Task[]                 @relation("TaskOwner")
  dailyPlans            DailyPlan[]
  timeEntries           TimeEntry[]
  gateReviews           GateReview[]
  gateOverrides         GateOverride[]
  communications        Communication[]
  interviews            Interview[]            @relation("Interviewer")
  founderAssessments    FounderAssessment[]    @relation("AssessmentAuthor")
  subjectAssessments    FounderAssessment[]    @relation("AssessmentSubject")
  memberValueStatements MemberValueStatement[]
  adviceItems           AdviceItem[]
  decisions             Decision[]
  ownedRisks            Risk[]
  documents             Document[]
  founderActions        FounderActionRequest[] @relation("ActionAssignee")
  createdActions        FounderActionRequest[] @relation("ActionCreator")
  notifications         Notification[]
  weeklyReports         WeeklyReport[]
  auditLogs             AuditLog[]
  meetingAttendees      MeetingAttendee[]
  coordinatorNotes      CoordinatorNote[]
  appIssueReports       AppIssueReport[]
}

model CoordinatorNote {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @default("")
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, updatedAt])
}

enum AppIssueStatus {
  OPEN
  LOOKING
  FIXED
}

model AppIssueReport {
  id          String         @id @default(cuid())
  reporterId  String
  reporter    User           @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  title       String
  body        String
  pageOrTab   String         @default("")
  status      AppIssueStatus @default(OPEN)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  @@index([status, updatedAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

model TotpCredential {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret    String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, ip, createdAt])
}

model Stage {
  id          String      @id @default(cuid())
  weekNumber  Int         @unique
  title       String
  description String
  order       Int
  status      StageStatus @default(NOT_STARTED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  tasks Task[]
  gate  Gate?
}

model Task {
  id          String     @id @default(cuid())
  stageId     String
  stage       Stage      @relation(fields: [stageId], references: [id])
  title       String
  description String     @default("")
  status      TaskStatus @default(NOT_STARTED)
  ownerUserId String?
  owner       User?      @relation("TaskOwner", fields: [ownerUserId], references: [id])
  dueAt       DateTime?
  achievedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  checklist   TaskChecklistItem[]
  dodCriteria DefinitionOfDoneCriterion[]
  dependsOn   TaskDependency[]            @relation("DependentTask")
  dependedBy  TaskDependency[]            @relation("PrerequisiteTask")
  planItems   DailyPlanItem[]
  timeEntries TimeEntry[]
}

model TaskChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label     String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DefinitionOfDoneCriterion {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label      String
  satisfied  Boolean  @default(false)
  order      Int      @default(0)
  overridden Boolean  @default(false)
  overrideReason String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TaskDependency {
  id              String @id @default(cuid())
  taskId          String
  dependsOnTaskId String
  task            Task   @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn       Task   @relation("PrerequisiteTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
}

model DailyPlan {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  date           DateTime @db.Date
  notes          String   @default("")
  plannedMinutes Int      @default(240)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items DailyPlanItem[]

  @@unique([userId, date])
}

model DailyPlanItem {
  id      String  @id @default(cuid())
  planId  String
  plan    DailyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  taskId  String?
  task    Task?   @relation(fields: [taskId], references: [id])
  title   String
  minutes Int     @default(30)
  done    Boolean @default(false)
  order   Int     @default(0)
}

model TimeEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  minutes   Int
  note      String   @default("")
  spentAt   DateTime @default(now())
  createdAt DateTime @default(now())
}

model Gate {
  id          String   @id @default(cuid())
  stageId     String   @unique
  stage       Stage    @relation(fields: [stageId], references: [id])
  title       String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  criteria  GateCriterion[]
  reviews   GateReview[]
  overrides GateOverride[]
}

model GateCriterion {
  id           String            @id @default(cuid())
  gateId       String
  gate         Gate              @relation(fields: [gateId], references: [id], onDelete: Cascade)
  type         GateCriterionType
  label        String
  targetValue  Float?
  satisfied    Boolean           @default(false)
  evidenceNote String?
  order        Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model GateReview {
  id         String   @id @default(cuid())
  gateId     String
  gate       Gate     @relation(fields: [gateId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User     @relation(fields: [reviewerId], references: [id])
  summary    String
  passed     Boolean
  reviewedAt DateTime @default(now())
}

model GateOverride {
  id           String   @id @default(cuid())
  gateId       String
  gate         Gate     @relation(fields: [gateId], references: [id], onDelete: Cascade)
  authoriserId String
  authoriser   User     @relation(fields: [authoriserId], references: [id])
  reason       String
  createdAt    DateTime @default(now())
}

model Organisation {
  id        String          @id @default(cuid())
  name      String
  sector    String          @default("")
  status    OrgPersonStatus @default(ACTIVE)
  notes     String          @default("")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  people          Person[]
  communications  Communication[]
  interviews      Interview[]
}

model Person {
  id             String          @id @default(cuid())
  organisationId String?
  organisation   Organisation?   @relation(fields: [organisationId], references: [id])
  name           String
  email          String?
  phone          String?
  roleTitle      String?
  status         OrgPersonStatus @default(ACTIVE)
  notes          String          @default("")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  communications   Communication[]
  interviews       Interview[]
  meetingAttendees MeetingAttendee[]
}

model Communication {
  id             String        @id @default(cuid())
  personId       String?
  person         Person?       @relation(fields: [personId], references: [id])
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  channel        String
  summary        String
  occurredAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())
}

model InterviewTemplate {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())

  questions InterviewTemplateQuestion[]
  interviews Interview[]
}

model InterviewTemplateQuestion {
  id         String       @id @default(cuid())
  templateId String
  template   InterviewTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  prompt     String
  kind       QuestionKind @default(TEXT)
  order      Int          @default(0)

  answers InterviewAnswer[]
}

model Interview {
  id             String         @id @default(cuid())
  templateId     String
  template       InterviewTemplate @relation(fields: [templateId], references: [id])
  organisationId String?
  organisation   Organisation?  @relation(fields: [organisationId], references: [id])
  personId       String?
  person         Person?        @relation(fields: [personId], references: [id])
  interviewerId  String
  interviewer    User           @relation("Interviewer", fields: [interviewerId], references: [id])
  conductedAt    DateTime       @default(now())
  notes          String         @default("")
  createdAt      DateTime       @default(now())
  deletedAt      DateTime?

  answers InterviewAnswer[]
}

model InterviewAnswer {
  id          String                   @id @default(cuid())
  interviewId String
  interview   Interview                @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionId  String
  question    InterviewTemplateQuestion @relation(fields: [questionId], references: [id])
  valueText   String?
  valueNumber Float?
  valueBool   Boolean?
  confidential Boolean                 @default(false)

  tags InterviewAnswerTag[]
}

model ProblemTag {
  id   String @id @default(cuid())
  name String @unique

  answers InterviewAnswerTag[]
}

model InterviewAnswerTag {
  id       String          @id @default(cuid())
  answerId String
  tagId    String
  answer   InterviewAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  tag      ProblemTag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([answerId, tagId])
}

model FounderAssessment {
  id             String   @id @default(cuid())
  subjectUserId  String?
  subject        User?    @relation("AssessmentSubject", fields: [subjectUserId], references: [id])
  authorId       String
  author         User     @relation("AssessmentAuthor", fields: [authorId], references: [id])
  title          String
  positiveNotes  String   @default("")
  redFlagPrompts String   @default("")
  evidenceNotes  String   @default("")
  status         String   @default("DRAFT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
}

model Supplier {
  id        String    @id @default(cuid())
  name      String
  category  String    @default("")
  contact   String    @default("")
  notes     String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  offers SupplierOffer[]
}

model SupplierOffer {
  id                     String               @id @default(cuid())
  supplierId             String
  supplier               Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  description            String
  unitPrice              Decimal?             @db.Decimal(12, 2)
  currency               String               @default("EUR")
  confidentialMemberScope String?
  notes                  String               @default("")
  assumptionConfidence   AssumptionConfidence @default(ESTIMATE)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?
}

model FinancialAssumption {
  id         String               @id @default(cuid())
  key        String
  label      String
  value      String
  unit       String?
  confidence AssumptionConfidence
  scenario   String?
  notes      String               @default("")
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  deletedAt  DateTime?

  @@unique([key, scenario])
}

model MemberValueStatement {
  id            String   @id @default(cuid())
  memberLabel   String
  inputsJson    Json
  resultJson    Json
  calculatedAt  DateTime @default(now())
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
}

model AdviceItem {
  id         String       @id @default(cuid())
  category   String
  title      String
  body       String
  status     AdviceStatus @default(OPEN)
  adviserId  String?
  adviser    User?        @relation(fields: [adviserId], references: [id])
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?
}

model Meeting {
  id          String    @id @default(cuid())
  title       String
  scheduledAt DateTime
  location    String?
  notes       String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  attendees MeetingAttendee[]
  decisions Decision[]
}

model MeetingAttendee {
  id       String  @id @default(cuid())
  meetingId String
  meeting  Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id])
  personId String?
  person   Person? @relation(fields: [personId], references: [id])
}

model Decision {
  id          String    @id @default(cuid())
  meetingId   String?
  meeting     Meeting?  @relation(fields: [meetingId], references: [id])
  title       String
  body        String
  decidedAt   DateTime  @default(now())
  decidedById String
  decidedBy   User      @relation(fields: [decidedById], references: [id])
  createdAt   DateTime  @default(now())
}

model Risk {
  id          String     @id @default(cuid())
  title       String
  probability Int
  impact      Int
  rating      Int
  mitigation  String     @default("")
  ownerId     String?
  owner       User?      @relation(fields: [ownerId], references: [id])
  trigger     String     @default("")
  status      RiskStatus @default(OPEN)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
}

model Document {
  id           String    @id @default(cuid())
  key          String
  filename     String
  mimeType     String
  size         Int
  sha256       String
  version      Int       @default(1)
  visibility   String    @default("COORDINATOR")
  linkedType   String?
  linkedId     String?
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  registrationRequirements RegistrationRequirement[]
}

model Template {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  body      String
  category  String   @default("GENERAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RegistrationRequirement {
  id                 String               @id @default(cuid())
  code               String               @unique
  title              String
  description        String               @default("")
  priority           RegistrationPriority
  evidenceDocumentId String?
  evidenceDocument   Document?            @relation(fields: [evidenceDocumentId], references: [id])
  completed          Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model FounderActionRequest {
  id           String              @id @default(cuid())
  title        String
  detail       String              @default("")
  assigneeId   String
  assignee     User                @relation("ActionAssignee", fields: [assigneeId], references: [id])
  createdById  String
  createdBy    User                @relation("ActionCreator", fields: [createdById], references: [id])
  status       FounderActionStatus @default(OPEN)
  lastAction   FounderActionType?
  comment      String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model WeeklyReport {
  id          String    @id @default(cuid())
  weekNumber  Int
  body        String
  authoredById String
  authoredBy  User      @relation(fields: [authoredById], references: [id])
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
